# Runtime
NODE_ENV=production
# Internal API port used by the single Docker image. Keep this at 8787.
PORT=8787
PUBLIC_BASE_URL=

# Admin auth (set both to enable login)
BASIC_USER=admin
BASIC_PASS=change_this_password
SESSION_COOKIE_NAME=k_vault_session
SESSION_DURATION_MS=86400000

# Optional in Docker: if missing or left as placeholders, the container writes
# persistent generated values to /app/data/runtime.env on first start.
CONFIG_ENCRYPTION_KEY=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_another_long_random_secret

# Guest upload policy
GUEST_UPLOAD=false
GUEST_MAX_FILE_SIZE=5242880
GUEST_DAILY_LIMIT=10

# Upload limits
UPLOAD_MAX_SIZE=104857600
UPLOAD_SMALL_FILE_THRESHOLD=20971520
CHUNK_SIZE=5242880
# How many uploads are processed at once. Upload bodies are buffered whole, so
# concurrency multiplies the memory peak; 2 keeps a 100MB-class deployment well
# inside a 896MB MemoryMax.
UPLOAD_MAX_CONCURRENCY=2
# Ceiling for storage backends that cannot stream (HuggingFace and GitHub both
# require the content base64-encoded inside a JSON body). Defaults to
# min(UPLOAD_MAX_SIZE, 100MB). Leave empty to use that default.
BUFFERED_BACKEND_MAX_SIZE=
# Cap for /api/upload-from-url and resolved-media imports. Defaults to
# UPLOAD_MAX_SIZE, because that is the deployment's real capacity knob; the
# target storage backend still applies on top (Telegram cloud 50MB, Discord
# 25MB, ...). The body is buffered in memory, so keep MemoryMax in step with
# UPLOAD_MAX_SIZE. Set this only to pin a value different from UPLOAD_MAX_SIZE.
URL_IMPORT_MAX_SIZE=

# Data locations in container
DATA_DIR=/app/data
DB_PATH=/app/data/k-vault.db
CHUNK_DIR=/app/data/chunks

# Basic settings storage backend (sqlite | redis)
SETTINGS_STORE=sqlite
# For Upstash/Redis/KVrocks, set a redis:// or rediss:// URL
# Example with local compose profile: redis://redis:6379
SETTINGS_REDIS_URL=
SETTINGS_REDIS_PREFIX=k-vault
SETTINGS_REDIS_CONNECT_TIMEOUT_MS=5000

# Optional bootstrap default storage selection
# Values: telegram | r2 | s3 | discord | huggingface | webdav | github
DEFAULT_STORAGE_TYPE=telegram

# Telegram bootstrap
TG_BOT_TOKEN=
TG_CHAT_ID=
CUSTOM_BOT_API_URL=https://api.telegram.org

# R2 / S3 bootstrap
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Discord bootstrap
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# HuggingFace bootstrap
HF_TOKEN=
HF_REPO=

# WebDAV bootstrap
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_BEARER_TOKEN=
WEBDAV_ROOT_PATH=

# GitHub bootstrap
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_MODE=releases
GITHUB_PREFIX=
GITHUB_RELEASE_TAG=
GITHUB_BRANCH=
GITHUB_API_BASE=https://api.github.com

# API v1 CORS allow-list for browser clients (server-to-server agents need none)
# Comma-separated origins; trailing slashes are normalized. Leave empty to send
# no CORS headers at all. Example:
# API_CORS_ORIGINS=https://app.example.com,https://dashboard.example.com
API_CORS_ORIGINS=

# Media resolve (yt-dlp) — Docker / self-hosted runtime only.
# Needs the yt-dlp binary in PATH; the published image ships one. The Pages
# runtime has no child_process, so these settings are ignored there.
MEDIA_RESOLVE_ENABLED=true
# Absolute paths when the binaries are not in PATH.
MEDIA_RESOLVE_YTDLP_PATH=
# ffmpeg is required to store Bilibili / YouTube videos: those platforms only
# expose separate video and audio tracks, which yt-dlp muxes with ffmpeg.
MEDIA_RESOLVE_FFMPEG_PATH=
# User-Agent used for both resolving and downloading. It must NOT start with
# "Mozilla/" — Bilibili answers 412 to a browser-like UA that lacks a real
# browser signature, while accepting an API-style one.
MEDIA_RESOLVE_USER_AGENT=yt-dlp
# Wall-clock caps: resolve metadata vs. download + mux.
MEDIA_RESOLVE_TIMEOUT_MS=60000
MEDIA_RESOLVE_DOWNLOAD_TIMEOUT_MS=600000
MEDIA_RESOLVE_MAX_CONCURRENCY=2
# Optional guards. 0 disables each check; MAX_FILE_SIZE is in bytes.
MEDIA_RESOLVE_MAX_DURATION_SECONDS=0
MEDIA_RESOLVE_MAX_FILE_SIZE=0
MEDIA_RESOLVE_MAX_URL_LENGTH=2048
# Where yt-dlp writes temporary downloads before they are stored. Defaults to
# DATA_DIR/tmp. Keep it on a volume with room for one video.
# Prefer setting this explicitly on systemd: units commonly ship
# PrivateTmp=true, which turns the service's /tmp into a private mount that the
# host can neither inspect nor clean up.
MEDIA_RESOLVE_TEMP_DIR=
# Cookies unlock B站 1080P+ / 抖音 and similar; Netscape cookies.txt format.
# Only needs to be READABLE by the service user: yt-dlp is handed a throwaway
# copy per run (it rewrites --cookies on exit), so the master jar stays intact.
MEDIA_RESOLVE_COOKIES_FILE=
# Set when the host needs a proxy to reach the platform, e.g. an overseas
# server talking to mainland CDNs.
MEDIA_RESOLVE_PROXY=
# Extra hosts appended to the built-in allow-list (comma or space separated).
MEDIA_RESOLVE_EXTRA_HOSTS=
# Allow ANY host. Off by default so a public deployment cannot be turned into a
# general-purpose request forwarder.
MEDIA_RESOLVE_ALLOW_UNKNOWN_HOSTS=false

# --- Capabilities -----------------------------------------------------------
# YouTube has required an external JavaScript runtime for full support since
# yt-dlp 2025.11.12. Without one yt-dlp silently drops the `web` player client
# and only degraded fallbacks remain, which breaks most videos. Node ships in
# the published image, so that is the default; set to `none` to omit the flag
# entirely, or install deno and set this to deno.
MEDIA_RESOLVE_JS_RUNTIME=node
# Absolute path to the runtime, if it is not on PATH.
MEDIA_RESOLVE_JS_RUNTIME_PATH=
# Allow yt-dlp to fetch the EJS challenge-solver components (ejs:npm or
# ejs:github). Official builds bundle them, so this is normally unnecessary.
MEDIA_RESOLVE_REMOTE_COMPONENTS=

# --- Anti-bot and retry hardening -------------------------------------------
# The 403s and 5xx the big platforms emit mid-download are usually transient.
# RETRY_SLEEP uses yt-dlp's own syntax; http:exp=1:20 means exponential backoff
# starting at 1s, capped at 20s.
MEDIA_RESOLVE_EXTRACTOR_RETRIES=3
MEDIA_RESOLVE_FRAGMENT_RETRIES=10
MEDIA_RESOLVE_RETRY_SLEEP=http:exp=1:20
MEDIA_RESOLVE_SOCKET_TIMEOUT=20
# Concurrent DASH/HLS fragments per download. This is the supported way to
# speed up a segmented download: aria2c as an external downloader for HLS/DASH
# was removed in yt-dlp 2026.06.09 over CVE-2026-50574.
MEDIA_RESOLVE_CONCURRENT_FRAGMENTS=4
MEDIA_RESOLVE_MAX_CONCURRENT_FRAGMENTS=16
# Optional global download rate cap, e.g. 4.2M. Empty means unlimited.
MEDIA_RESOLVE_LIMIT_RATE=
# Ceiling yt-dlp enforces before writing, e.g. 2G. Empty means unlimited.
MEDIA_RESOLVE_MAX_FILESIZE=
# Operator-level extractor arguments, always applied. This is TRUSTED input, so
# it is the only place keys that decide where requests go can be set — the
# request-level extractorArgs field refuses them as an SSRF guard.
# Examples:
#   youtube:player_client=default,-web
#   youtube:fetch_pot=auto
#   tiktok:api_hostname=api22-normal-c-useast2a.tiktokv.com
MEDIA_RESOLVE_EXTRACTOR_ARGS=
# TLS fingerprint impersonation, e.g. chrome, chrome-136, chrome:windows-10.
# Requires curl_cffi inside the yt-dlp build; check
# `yt-dlp --list-impersonate-targets` to see what your build offers. A target
# this build cannot do is reported and ignored rather than failing the run.
# May hurt download speed and stability.
MEDIA_RESOLVE_IMPERSONATE=

# --- Media enrichment defaults ----------------------------------------------
# These change the bytes that land in storage, so they are off by default.
# Once enabled they apply to every resolve unless the request says otherwise.
MEDIA_RESOLVE_WRITE_SUBTITLES=false
# Comma-separated language selectors; "zh.*" means every Chinese variant.
MEDIA_RESOLVE_SUBTITLE_LANGS=zh.*,en
MEDIA_RESOLVE_WRITE_THUMBNAIL=false
# Save yt-dlp's info JSON alongside the media (a metadata source for Jellyfin).
MEDIA_RESOLVE_WRITE_INFO_JSON=false
# Generate Kodi/Jellyfin-compatible NFO sidecars.
MEDIA_RESOLVE_WRITE_NFO=false
# Embed metadata / cover art into the media file itself (needs ffmpeg).
MEDIA_RESOLVE_EMBED_METADATA=false
MEDIA_RESOLVE_EMBED_THUMBNAIL=false

# --- Limits on the extended surface -----------------------------------------
# Upload subtitles/thumbnails/NFO alongside the media.
MEDIA_RESOLVE_SIDECAR_ENABLED=true
# Cap on the files one resolve may emit, and on the size of each.
MEDIA_RESOLVE_MAX_SIDECAR_FILES=12
MEDIA_RESOLVE_MAX_SIDECAR_BYTES=20971520
# Playlist/channel expansion. On a public deployment this is the difference
# between one video and a thousand, so MAX_PLAYLIST_ITEMS bounds each request.
MEDIA_RESOLVE_ALLOW_PLAYLISTS=true
MEDIA_RESOLVE_MAX_PLAYLIST_ITEMS=25
# Live streams have no natural end, so they get their own switch.
MEDIA_RESOLVE_ALLOW_LIVE=true
# Progress reporting for detached downloads, and how much history to retain.
MEDIA_RESOLVE_PROGRESS=true
MEDIA_RESOLVE_PROGRESS_HISTORY=64
